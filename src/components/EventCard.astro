---
import { kindLabels, type ClubEvent } from '../data/events';
import { site, fullAddress } from '../data/site';

interface Props {
  event: ClubEvent;
  past?: boolean;
}

const { event, past = false } = Astro.props;

const d = new Date(`${event.date}T12:00:00`);
const month = d.toLocaleDateString('en-US', { month: 'short' });
const day = d.toLocaleDateString('en-US', { day: 'numeric' });
const weekday = d.toLocaleDateString('en-US', { weekday: 'short' });
const iso = event.date;
const year = d.getFullYear();

const where = event.location ?? (site.meeting.venue || fullAddress);
const when = event.time || (event.location ? '' : site.meeting.time);
---

<article class:list={['event', { 'event--past': past }]}>
  <time class="date" datetime={iso}>
    <span class="month">{month}</span>
    <span class="day">{day}</span>
    <span class="weekday">{weekday} {year}</span>
  </time>

  <div class="body">
    <p class="kind">{kindLabels[event.kind]}</p>
    <h3>{event.title}</h3>

    {
      event.book && (
        <p class="book">
          <em>{event.book.title}</em> — {event.book.author}
          {event.book.note && <span class="book-note"> ({event.book.note})</span>}
        </p>
      )
    }

    <p class="meta">
      {when && <span>{when}</span>}
      <span>{where}</span>
    </p>

    {event.description && <p class="desc">{event.description}</p>}
  </div>
</article>

<style>
  .event {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: clamp(1rem, 3vw, 2rem);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule-soft);
  }

  .event:first-of-type {
    border-top: 1px solid var(--rule-soft);
  }

  .event--past {
    color: var(--muted);
  }

  .date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    padding: 0.45rem 0.25rem 0.55rem;
    border: 3px solid var(--rule);
    background: var(--paper-raised);
    line-height: 1;
    height: fit-content;
  }

  .event--past .date {
    border-color: var(--rule-soft);
  }

  .month {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    color: var(--accent);
  }

  .event--past .month {
    color: inherit;
  }

  .day {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.3rem;
    letter-spacing: -0.04em;
    margin-block: 0.15rem 0.25rem;
    color: var(--ink);
  }

  .event--past .day {
    color: inherit;
  }

  .weekday {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .body {
    min-width: 0;
  }

  .kind {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.3rem;
  }

  h3 {
    margin-bottom: 0.35rem;
  }

  .book {
    margin: 0 0 0.35rem;
    font-size: 0.98rem;
  }

  .book-note {
    color: var(--muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .meta span + span::before {
    content: '·';
    margin-right: 0.9rem;
  }

  .desc {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
  }

  @media (max-width: 30rem) {
    .event {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .date {
      flex-direction: row;
      align-items: baseline;
      gap: 0.5rem;
      justify-content: flex-start;
      width: fit-content;
      padding: 0.35rem 0.7rem;
    }

    .day {
      font-size: 1.4rem;
      margin: 0;
    }
  }
</style>
