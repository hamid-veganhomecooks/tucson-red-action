---
import { Image } from 'astro:assets';
import { site } from '../data/site';

interface Props {
  size?: number;
}

const { size = 52 } = Astro.props;

/**
 * Drop your logo at src/assets/logo.png (or .svg / .jpg / .webp) and it is
 * picked up here automatically and optimized at build time. Until then we fall
 * back to the red star mark below.
 */
const found = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/logo.{svg,png,jpg,jpeg,webp,avif}',
  { eager: true }
);

/**
 * Glob results come back in alphabetical order, not preference order, so with
 * both logo.png and logo.svg on disk the PNG would win. Pick by extension
 * instead: a vector beats a bitmap, and dropping in logo.svg just works.
 */
const entries = Object.entries(found);
const logo = ['.svg', '.png', '.jpg', '.jpeg', '.webp', '.avif']
  .map((ext) => entries.find(([path]) => path.endsWith(`logo${ext}`))?.[1]?.default)
  .find(Boolean);
---

{
  logo ? (
    <Image
      src={logo}
      alt={`${site.name} logo`}
      width={size}
      height={size}
      densities={[1, 2, 3]}
      loading="eager"
      class="logo"
    />
  ) : (
    <svg
      class="logo"
      width={size}
      height={size}
      viewBox="0 0 100 100"
      role="img"
      aria-label={`${site.name} logo`}
    >
      <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="7" />
      <path
        fill="var(--accent)"
        d="M50 24 L57.6 43.4 L78.5 44.6 L62.3 57.8 L67.6 78 L50 66.8 L32.4 78 L37.7 57.8 L21.5 44.6 L42.4 43.4 Z"
      />
    </svg>
  )
}

<style>
  .logo {
    display: block;
    flex: none;
    object-fit: contain;
  }

  @media (prefers-color-scheme: dark) {
    .logo {
      /* The mark is a single dark green, which all but vanishes on the dark
         page. Lift it rather than shipping a second file. */
      filter: brightness(2.4);
    }
  }
</style>
